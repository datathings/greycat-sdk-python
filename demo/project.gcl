var tables: nodeIndex<String, Table>;

enum Constants {
    DATA_PATH("data");
}

fn load(file: File): Table? {
    var reader = CsvReader {
        path: file.path,
        format: CsvFormat {
            header_lines: 1,
        },
    };
    var table = Table {};
    try {
        while (reader.can_read()) {
            table.add_row(reader.read());
        }
    } catch (err) {
        warn("Failed to load ${file.path}: ${err.message}");
        return null;
    }
    return table;
}

fn init() {
    if (0 == tables.size()) {
        tables = nodeIndex<String, Table> {};
    }
    var dataPath = valueOf(Constants::DATA_PATH);
    for (_, file: File in File::ls(dataPath, ".csv", false)) {
        var table = load(file);
        if (null != table) {
            tables.set("${dataPath}/${file.name()}", table);
        }
    }
}

fn main() {
    init();
}

@expose
fn get_csv(csv_path: String): Table {
    return tables.get(csv_path)!!;
}
